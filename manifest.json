            ]
          },
          {
            "matcher": "Bash",
            "hooks": [
              {
                "type": "command",
                "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/kata/hooks/guard-git.py",
                "timeout": 10
              },
              {
                "type": "command",
                "command": "python3 \"$CLAUDE_PROJECT_DIR\"/.claude/kata/hooks/guard-delete.py",
                "timeout": 10
