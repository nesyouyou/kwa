                "timeout": 10
              }
            ]
          }
        ]
      },
      "policy": {
        "bash": {
          "deny": [
            {
              "id": "force-push",
              "reason": "Force-push interdit (y compris dans un script interprété).",
              "all": [
                "git +push\\b.*(--force( |$)|-f( |$))"
              ]
            }
          ]
        }
      }
